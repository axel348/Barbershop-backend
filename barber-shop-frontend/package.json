{
  "name": "@barbershop/barber-shop-ui",
  "version": "1.0.0",
  "description": "Componentes React para tienda de productos de barbería — consume barber-shop-bff",
  "type": "module",
  "main": "./dist/barber-shop-ui.cjs",
  "module": "./dist/barber-shop-ui.js",
  "exports": {
    ".": {
      "import": "./dist/barber-shop-ui.js",
      "require": "./dist/barber-shop-ui.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-router-dom": "^6.22.0 || ^7.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  },
  "keywords": [
    "react",
    "barbershop",
    "bff",
    "vite",
    "ui-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barbershop/barber-shop-frontend.git"
  }
