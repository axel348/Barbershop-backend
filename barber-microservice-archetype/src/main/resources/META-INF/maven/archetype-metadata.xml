<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
        xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0
        https://maven.apache.org/xsd/archetype-descriptor-1.2.0.xsd"
        name="barber-microservice-archetype">

    <fileSets>
        <fileSet filtered="true" packaged="false" encoding="UTF-8">
            <directory></directory>
            <includes>
                <include>pom.xml</include>
                <include>.gitignore</include>
                <include>README.md</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="false" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
            <fileNameFiltering>true</fileNameFiltering>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/test/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
            <fileNameFiltering>true</fileNameFiltering>
        </fileSet>
    </fileSets>

    <requiredProperties>
        <requiredProperty key="package">
            <defaultValue>com.barbershop.microservice</defaultValue>
        </requiredProperty>
        <requiredProperty key="serviceName">
            <defaultValue>Sample</defaultValue>
        </requiredProperty>
        <requiredProperty key="apiPath">
            <defaultValue>samples</defaultValue>
        </requiredProperty>
        <requiredProperty key="serverPort">
            <defaultValue>8083</defaultValue>
        </requiredProperty>
        <requiredProperty key="dbName">
            <defaultValue>sampledb</defaultValue>
        </requiredProperty>
        <requiredProperty key="serviceDescription">
            <defaultValue>Microservicio REST de barbería generado por arquetipo</defaultValue>
        </requiredProperty>
    </requiredProperties>
</archetype-descriptor>
